{
  "rules": {
    "users": {
      ".read": "auth != null",
      
      "$uid": {
        ".write": "$uid === auth.uid",
        
        "workspaces": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid"
        }
      }
    },
    
    "workspaces": {
      "$workspaceId": {
        ".read": "auth != null && (root.child('workspaces/' + $workspaceId + '/ownerId').val() === auth.uid || root.child('workspaces/' + $workspaceId + '/members/' + auth.uid).exists())",
        
        "name": {
          ".write": "auth != null && root.child('workspaces/' + $workspaceId + '/ownerId').val() === auth.uid"
        },
        
        "ownerId": {
          ".write": "auth != null && (!root.child('workspaces/' + $workspaceId).exists() && newData.val() === auth.uid)"
        },
        
        "createdAt": {
          ".write": "auth != null && (!root.child('workspaces/' + $workspaceId).exists())"
        },
        
        "updatedAt": {
          ".write": "auth != null && (root.child('workspaces/' + $workspaceId + '/ownerId').val() === auth.uid || root.child('workspaces/' + $workspaceId + '/members/' + auth.uid).exists())"
        },
        
        "members": {
          ".read": "auth != null && (root.child('workspaces/' + $workspaceId + '/ownerId').val() === auth.uid || root.child('workspaces/' + $workspaceId + '/members/' + auth.uid).exists())",
          
          "$memberId": {
            ".write": "auth != null && root.child('workspaces/' + $workspaceId + '/ownerId').val() === auth.uid"
          }
        },
        
        "ideas": {
          ".read": "auth != null && (root.child('workspaces/' + $workspaceId + '/ownerId').val() === auth.uid || root.child('workspaces/' + $workspaceId + '/members/' + auth.uid).exists())",
          
          "$ideaId": {
            ".write": "auth != null && (root.child('workspaces/' + $workspaceId + '/ownerId').val() === auth.uid || root.child('workspaces/' + $workspaceId + '/members/' + auth.uid).exists())"
          }
        },
        
        "connections": {
          ".read": "auth != null && (root.child('workspaces/' + $workspaceId + '/ownerId').val() === auth.uid || root.child('workspaces/' + $workspaceId + '/members/' + auth.uid).exists())",
          
          "$connectionId": {
            ".write": "auth != null && (root.child('workspaces/' + $workspaceId + '/ownerId').val() === auth.uid || root.child('workspaces/' + $workspaceId + '/members/' + auth.uid).exists())"
          }
        },
        
        "components": {
          ".read": "auth != null && (root.child('workspaces/' + $workspaceId + '/ownerId').val() === auth.uid || root.child('workspaces/' + $workspaceId + '/members/' + auth.uid).exists())",
          
          "$componentId": {
            ".write": "auth != null && (root.child('workspaces/' + $workspaceId + '/ownerId').val() === auth.uid || root.child('workspaces/' + $workspaceId + '/members/' + auth.uid).exists())"
          }
        },
        
        "projects": {
          ".read": "auth != null && (root.child('workspaces/' + $workspaceId + '/ownerId').val() === auth.uid || root.child('workspaces/' + $workspaceId + '/members/' + auth.uid).exists())",
          
          "$projectId": {
            ".write": "auth != null && (root.child('workspaces/' + $workspaceId + '/ownerId').val() === auth.uid || root.child('workspaces/' + $workspaceId + '/members/' + auth.uid).exists())"
          }
        }
      }
    }
  }
}
